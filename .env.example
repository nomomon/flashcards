# Copy to .env and fill in. Nothing here is needed to run the app.

# Where the frontend loads decks from. Defaults to same-origin "/data" - this
# repo's own data/ folder, served by `pnpm dev` and copied into the build - so
# leaving it unset gives a working app with the decks committed here.
#
# Set it to an absolute URL to read decks published somewhere else. The service
# worker's caching rules and postbuild's data copy both follow it, and the host
# must send Access-Control-Allow-Origin. Empty counts as unset.
#
# In CI this comes from the repository variable DATA_BASE_URL, not from a file.
# VITE_DATA_BASE_URL=https://nomomon.github.io/flashcards-decks
